#!/bin/sh
# Runs inside the image after packages and ExtraTrees are installed.
set -eu

# Kiosk user. DEV ONLY password; replace with SSH keys before real use.
if ! id music >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash music
    echo 'music:music' | chpasswd
fi
for g in audio video render input sudo; do
    getent group "$g" >/dev/null && usermod -aG "$g" music
done

# music library root; /srv/music/local is for files copied onto the device
mkdir -p /srv/music/local
chown music:audio /srv/music/local
chmod 2775 /srv/music/local

# agent state (settings, sources, cover cache); readable so MPD can include the output config
install -d -o music -g music -m 0755 /var/lib/musicos
if [ ! -f /var/lib/musicos/mpd-output.conf ]; then
    cat > /var/lib/musicos/mpd-output.conf <<'EOF'
audio_output {
    type        "alsa"
    name        "musicos"
    device      "default"
    mixer_type  "software"
}
EOF
fi
install -d -m 0700 /etc/musicos/creds

chmod 755 /usr/local/bin/musicos-browser

systemctl enable NetworkManager systemd-resolved systemd-timesyncd avahi-daemon ssh mpd \
    musicos-agent musicos-kiosk musicos-apply.path musicos-apply.service
# NetworkManager owns networking; networkd's wait-online would stall boot for 2 minutes
systemctl disable systemd-networkd.service systemd-networkd.socket systemd-networkd-wait-online.service 2>/dev/null || true
systemctl set-default graphical.target
