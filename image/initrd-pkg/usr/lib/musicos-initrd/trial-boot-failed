#!/bin/sh
var=/sys/firmware/efi/efivars/LoaderBootCountPath-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
if [ ! -e "$var" ]; then
    # a known-good version that fails to start: say what to do (no one has a root password)
    cat > /dev/console 2>/dev/null <<'MSG'

  musicos could not start.

  Your music drives are not affected. To fix it:
    1. Restart. Damaged files on the internal disk are repaired automatically at boot.
    2. Still stuck? Start from the musicos USB stick and use
       Settings > Updates & install > Install on this computer.
MSG
    exit 0
fi
echo "musicos: this version did not start; restarting (the previous version returns after 3 tries)" > /dev/console 2>/dev/null
sleep 5
systemctl reboot --force || reboot -f
