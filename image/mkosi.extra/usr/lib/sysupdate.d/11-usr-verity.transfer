[Transfer]
ProtectVersion=%A

[Source]
Type=regular-file
Path=/var/lib/musicos/updates
MatchPattern=musicos_@v.usr-verity.@u.raw

[Target]
Type=partition
Path=auto
MatchPattern=musicos_@v_verity
MatchPartitionType=usr-verity
ReadOnly=1
# never set the grow-filesystem flag on a read-only erofs /usr
GrowFileSystem=no
