# Boots straight into the UI: cage (single-app Wayland compositor) on tty1 running the browser.
# Takes over from the Plymouth splash without flashing the console in between.
[Unit]
Description=musicos kiosk
Wants=musicos-agent.service
After=musicos-agent.service systemd-user-sessions.service plymouth-start.service
Conflicts=getty@tty1.service plymouth-quit.service
After=getty@tty1.service plymouth-quit.service

[Service]
User=music
PAMName=login
TTYPath=/dev/tty1
UtmpIdentifier=tty1
UtmpMode=user
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
Environment=XDG_SESSION_TYPE=wayland
EnvironmentFile=/usr/share/musicos/kiosk.env
EnvironmentFile=-/etc/musicos/kiosk.env
# survives restarts within a boot: remembers the software-rendering fallback
RuntimeDirectory=musicos-kiosk
RuntimeDirectoryPreserve=yes
# "+" runs as root: keep the last splash frame on screen until cage draws.
# Bounded: if plymouthd is wedged, never block the UI behind it.
ExecStartPre=+-/usr/bin/timeout 5 /usr/bin/plymouth quit --retain-splash
ExecStart=/usr/local/bin/musicos-session
TimeoutStartSec=30
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
