[Unit]
Description=musicos player agent (HTTP API + UI)
Wants=mpd.service
After=mpd.service network.target

[Service]
User=music
Environment=PYTHONPATH=/usr/lib/musicos/agent
Environment=MUSICOS_UI=/usr/share/musicos/ui
Environment=MUSICOS_STATE=/var/lib/musicos
Environment=MUSICOS_MUSIC_ROOT=/srv/music
EnvironmentFile=/usr/share/musicos/agent.env
EnvironmentFile=-/etc/musicos/agent.env
ExecStart=/usr/bin/python3 -m musicos_agent
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
