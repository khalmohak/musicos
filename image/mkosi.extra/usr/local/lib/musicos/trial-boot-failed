#!/bin/sh
# Reboot if this boot is a counted trial of a new version (systemd-boot sets LoaderBootCountPath),
# so a bad update rolls back on its own. On a known-good version: do nothing (no reboot loops).
var=/sys/firmware/efi/efivars/LoaderBootCountPath-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
[ -e "$var" ] || exit 0
echo "musicos: $1 on a trial boot; restarting to try again or go back to the previous version" > /dev/console 2>/dev/null
echo "musicos: $1 on a trial boot; restarting"
sleep 5
systemctl reboot --force || reboot -f
