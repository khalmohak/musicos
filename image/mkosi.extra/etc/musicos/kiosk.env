# Environment for the kiosk (cage + browser).
# VMs often have no hardware cursor plane.
WLR_NO_HARDWARE_CURSORS=1
# WebKit's bubblewrap sandbox aborts under cage here ("bwrap: Unexpected capabilities
# but not setuid"), which crash-loops the kiosk. The browser only loads our own local
# UI, so running it unsandboxed is acceptable for now. TODO: find the root cause.
WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
# If the screen stays black in a VM without GPU acceleration, uncomment:
#WLR_RENDERER=pixman
#LIBGL_ALWAYS_SOFTWARE=1
# Chromium fallback / remote UI:
#MUSICOS_URL=http://127.0.0.1:8080/
